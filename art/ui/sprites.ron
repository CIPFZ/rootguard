// HUD 皮肤精灵（ART-SPEC 8.3）：文件名 = 精灵名，`viewBox` = 尺寸；锚点为归一化坐标。
// artgen 打进 garden_ui 图集，片段名 `ui_<名>`；游戏在 rootguard-app/src/hud.rs 按 HUD 布局绘制。
[
    (name: "hud_bar", anchor: (0.0, 0.0)),
    (name: "card_slot", anchor: (0.0, 0.0)),
    (name: "dew_box", anchor: (0.0, 0.0)),
    (name: "dew_icon", anchor: (0.5, 0.5)),
    (name: "shovel", anchor: (0.5, 0.5)),
    (name: "button", anchor: (0.0, 0.0)),
    (name: "wave_track", anchor: (0.0, 0.5)),
    (name: "wave_fill", anchor: (0.0, 0.5)),
    (name: "wave_flag", anchor: (0.5, 1.0)),
    (name: "banner", anchor: (0.5, 0.5)),
]
