// 陶盔枯壳 Clay Husk（ART-SPEC 5.3）：以枯壳怪为模板（裁决六），倒扣龟裂陶盆压到眉毛、盆沿垂一条根。面向左（2.2），画布 128 × 160、锚点 (0.5, 0.95)。
Rig(
    kind: Husk,
    rest: "walk",
    // 受击闪白 6 tick（2.3 / 5 共同）
    flash: true,
    parts: [
        (name: "shadow", pivot: (64, 152), z: 0),
        (name: "arm_back", parent: Some("body"), pivot: (83, 80), z: 1),
        (name: "leg_back", pivot: (73, 113), z: 2),
        (name: "leg_front", pivot: (60, 113), z: 3),
        // 身体以髋部为枢轴：行走左右摇摆 ± 4°、啃食俯身
        (name: "body", pivot: (65, 116), z: 4),
        (name: "head", parent: Some("body"), pivot: (56, 88), z: 6, variants: ["flat"]),
        (name: "helm", parent: Some("head"), pivot: (50, 44), z: 9, variants: ["cracked"]),
        (name: "mouth", parent: Some("head"), pivot: (46, 82), z: 7, variants: ["chomp"]),
        // 前臂在头后：驼背时头压在前肩上
        (name: "arm_front", parent: Some("body"), pivot: (52, 93), z: 5),
        (name: "crumbs", pivot: (34, 86), z: 8, hidden: true),
    ],
    // ART-SPEC 2.4 / 5.3：Helm 2 级裂纹；破碎时陶片四散，露出压扁的头顶
    states: [
        (name: "", set: {}),
        (name: "cracked", set: {"helm": "cracked"}),
        (name: "bare", set: {"helm": "hidden", "head": "flat"}),
    ],
)
