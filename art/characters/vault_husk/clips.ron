// 跳栏枯壳片段（ART-SPEC 3.1 / 5.5）。walk 的相位由走过的距离决定（ADR-016 第 4 节）；eat 时长 = bite_interval_ticks、
// 相位由 Biter 计时器驱动（裁决四），eat_hit 在末帧 50。以枯壳怪为模板（裁决六），去鸟化后的共用基础形（裁决七）。
Clips([
    // walk 32：芦苇杆长在前臂上，随臂摆动
    (
        name: "walk",
        looping: true,
        duration: Ticks(32),
        frames: Every(4),
        keys: {
            "body": [(t: 0, rot: -4), (t: 8, dy: -2), (t: 16, rot: 4), (t: 24, dy: -2), (t: 32, rot: -4)],
            "head": [(t: 0, rot: 3), (t: 16, rot: -3), (t: 32, rot: 3)],
            "leg_front": [(t: 0, rot: 13), (t: 16, rot: -12), (t: 32, rot: 13)],
            "leg_back": [(t: 0, rot: -12), (t: 16, rot: 13), (t: 32, rot: -12)],
            "arm_front": [(t: 0, rot: -8), (t: 16, rot: 7), (t: 32, rot: -8)],
            "arm_back": [(t: 0, rot: 7), (t: 16, rot: -8), (t: 32, rot: 7)],
        },
    ),
    // vault：时长 = Vault.ticks（数据为 40，ART-SPEC 5.5 写 30，以数据为准），相位 = 跨越已过 tick；撑杆、腾空、落地
    // （水平位置由模拟线性移动，呈现层只放姿态和弧线高度）
    (
        name: "vault",
        looping: false,
        duration: Rule("enemies.vault_husk.vault.ticks"),
        frames: List([6, 6, 8, 8, 6, 6]),
        keys: {
            "body": [(t: 0, dy: 4, rot: 4), (t: 6, dy: -8, rot: -12), (t: 12, dy: -22, rot: -20), (t: 20, dy: -26, rot: -8), (t: 28, dy: -12, rot: 4), (t: 34, dy: 3, rot: 6)],
            "leg_front": [(t: 0, dy: 4, rot: 20), (t: 6, dy: -8, rot: 30), (t: 12, dy: -22, rot: 40), (t: 20, dy: -26, rot: 30), (t: 28, dy: -12, rot: 10), (t: 34, dy: 3, rot: 6)],
            "leg_back": [(t: 0, dy: 4, rot: -10), (t: 6, dy: -8, rot: 20), (t: 12, dy: -22, rot: 34), (t: 20, dy: -26, rot: 24), (t: 28, dy: -12, rot: 0), (t: 34, dy: 3, rot: -6)],
            "arm_front": [(t: 0, rot: -20), (t: 6, rot: -30), (t: 12, rot: -10), (t: 20, rot: 10), (t: 28, rot: 16), (t: 34, rot: 0)],
            "head": [(t: 0, rot: -4), (t: 12, rot: 6), (t: 34, rot: 0)],
        },
    ),
    (
        name: "eat",
        looping: true,
        duration: Rule("enemies.vault_husk.bite_interval_ticks"),
        frames: List([10, 10, 10, 10, 10, 10]),
        events: [(50, "eat_hit")],
        keys: {
            "body": [(t: 0), (t: 20, rot: 2), (t: 30, rot: -3), (t: 40, dx: -2, rot: -7), (t: 50, dx: -3, rot: -10)],
            "head": [(t: 0, rot: 4), (t: 20, rot: 8), (t: 30), (t: 40, rot: -6), (t: 50, rot: -14)],
            "arm_front": [(t: 0, rot: 24), (t: 30, rot: 22), (t: 50, rot: 18)],
            "arm_back": [(t: 0, rot: 4), (t: 40, rot: -2), (t: 50, rot: -6)],
            "leg_front": [(t: 0, rot: 6)],
            "leg_back": [(t: 0, rot: -6)],
        },
        swaps: {
            "mouth": [(0, "base"), (50, "chomp")],
            "crumbs": [(50, "base")],
        },
    ),
])
