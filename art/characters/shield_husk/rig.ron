// 门板枯壳 Shield Husk（ART-SPEC 5.6）：以枯壳怪为模板（裁决六），胸前长着缠藤的风化木板，躲在板后只露眼睛和头顶。面向左（2.2），画布 128 × 160、锚点 (0.5, 0.95)。
Rig(
    kind: Husk,
    rest: "walk",
    // 受击闪白 6 tick（2.3 / 5 共同）
    flash: true,
    parts: [
        (name: "shadow", pivot: (64, 152), z: 0),
        (name: "arm_back", parent: Some("body"), pivot: (85, 78), z: 1),
        (name: "leg_back", pivot: (73, 113), z: 2),
        (name: "leg_front", pivot: (60, 113), z: 3),
        // 身体以髋部为枢轴：行走左右摇摆 ± 4°、啃食俯身
        (name: "body", pivot: (65, 116), z: 4),
        (name: "head", parent: Some("body"), pivot: (46, 103), z: 6, variants: ["lost"]),
        (name: "mouth", parent: Some("head"), pivot: (40, 95), z: 7, variants: ["chomp", "lost"]),
        (name: "shield", parent: Some("body"), pivot: (43, 120), z: 10, variants: ["cracked"]),
        // 前臂在头后：驼背时头压在前肩上
        (name: "arm_front", parent: Some("body"), pivot: (52, 94), z: 5),
        (name: "crumbs", pivot: (34, 86), z: 8, hidden: true),
    ],
    // ART-SPEC 2.4 / 5.6：Shield 2 级；破碎时木板碎成 3 块，它一脸茫然低头看
    states: [
        (name: "", set: {}),
        (name: "cracked", set: {"shield": "cracked"}),
        (name: "bare", set: {"shield": "hidden", "head": "lost", "mouth": "lost"}),
    ],
)
