// 背篓枯壳片段（ART-SPEC 3.1 / 5.7）。walk 的相位由走过的距离决定（ADR-016 第 4 节）；eat 时长 = bite_interval_ticks、
// 相位由 Biter 计时器驱动（裁决四），eat_hit 在末帧 50。以枯壳怪为模板（裁决六），去鸟化后的共用基础形（裁决七）。
Clips([
    // walk 48：慢、每步整身一沉，篓子一颠（5.7）
    (
        name: "walk",
        looping: true,
        duration: Ticks(48),
        frames: Every(6),
        keys: {
            "body": [(t: 0, rot: -3), (t: 12, dy: 2), (t: 24, rot: 3), (t: 36, dy: 2), (t: 48, rot: -3)],
            "head": [(t: 0, rot: 3), (t: 24, rot: -3), (t: 48, rot: 3)],
            "leg_front": [(t: 0, rot: 10), (t: 24, rot: -9), (t: 48, rot: 10)],
            "leg_back": [(t: 0, rot: -9), (t: 24, rot: 10), (t: 48, rot: -9)],
            "arm_front": [(t: 0, rot: -8), (t: 24, rot: 7), (t: 48, rot: -8)],
            "arm_back": [(t: 0, rot: 7), (t: 24, rot: -8), (t: 48, rot: 7)],
            "basket": [(t: 0), (t: 12, dy: -3, rot: 2), (t: 24), (t: 36, dy: -3, rot: 2), (t: 48)],
        },
    ),
    (
        name: "eat",
        looping: true,
        duration: Rule("enemies.carrier_husk.bite_interval_ticks"),
        frames: List([10, 10, 10, 10, 10, 10]),
        events: [(50, "eat_hit")],
        keys: {
            "body": [(t: 0), (t: 20, rot: 2), (t: 30, rot: -3), (t: 40, dx: -2, rot: -7), (t: 50, dx: -3, rot: -10)],
            "head": [(t: 0, rot: 4), (t: 20, rot: 8), (t: 30), (t: 40, rot: -6), (t: 50, rot: -14)],
            "arm_front": [(t: 0, rot: 24), (t: 30, rot: 22), (t: 50, rot: 18)],
            "arm_back": [(t: 0, rot: 4), (t: 40, rot: -2), (t: 50, rot: -6)],
            "leg_front": [(t: 0, rot: 6)],
            "leg_back": [(t: 0, rot: -6)],
        },
        swaps: {
            "mouth": [(0, "base"), (50, "chomp")],
            "crumbs": [(50, "base")],
        },
    ),
])
