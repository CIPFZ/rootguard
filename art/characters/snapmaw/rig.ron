    kind: Guardian,
    rest: "idle",
    flash: true,
    parts: [
        (name: "shadow", pivot: (60, 120), z: 0),
        (name: "stem", pivot: (56, 120), z: 1),
        (name: "head", pivot: (56, 70), z: 2, hidden: true),
        (name: "maw_lower", parent: Some("jaw_lower"), pivot: (28, 60), z: 2),
        (name: "maw_upper", parent: Some("jaw_upper"), pivot: (26, 57), z: 2),
        (name: "jaw_lower", parent: Some("head"), pivot: (28, 60), z: 3),
        (name: "jaw_upper", parent: Some("head"), pivot: (26, 57), z: 4),
        (name: "eyes", parent: Some("jaw_upper"), pivot: (72, 44), z: 5, variants: ["content"]),
        (name: "drool", parent: Some("jaw_lower"), pivot: (98, 69), z: 6),
    ],
