// 疾行枯壳 Sprinter Husk（ART-SPEC 5.4）：以枯壳怪为模板（裁决六），干藤拧成的瘦高身体、长根腿、前倾、圆睁的眼、速度线。面向左（2.2），画布 128 × 160、锚点 (0.5, 0.95)。
Rig(
    kind: Husk,
    rest: "walk",
    // 受击闪白 6 tick（2.3 / 5 共同）
    flash: true,
    parts: [
        (name: "shadow", pivot: (64, 152), z: 0),
        (name: "speedlines", pivot: (100, 95), z: 0),
        (name: "arm_back", parent: Some("body"), pivot: (83, 80), z: 1),
        (name: "leg_back", pivot: (73, 113), z: 2),
        (name: "leg_front", pivot: (60, 113), z: 3),
        // 身体以髋部为枢轴：行走左右摇摆 ± 4°、啃食俯身
        (name: "body", pivot: (64, 112), z: 4),
        (name: "head", parent: Some("body"), pivot: (56, 88), z: 6),
        (name: "mouth", parent: Some("head"), pivot: (46, 82), z: 7, variants: ["chomp"]),
        // 前臂在头后：驼背时头压在前肩上
        (name: "arm_front", parent: Some("body"), pivot: (52, 93), z: 5),
        (name: "crumbs", pivot: (34, 86), z: 8, hidden: true),
    ],
)
