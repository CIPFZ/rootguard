// 疾行枯壳片段（ART-SPEC 3.1 / 5.4）。walk 的相位由走过的距离决定（ADR-016 第 4 节）；eat 时长 = bite_interval_ticks、
// 相位由 Biter 计时器驱动（裁决四），eat_hit 在末帧 50。以枯壳怪为模板（裁决六），去鸟化后的共用基础形（裁决七）。
Clips([
    // walk 24：更快的步频、前倾 15°、身后速度线
    (
        name: "walk",
        looping: true,
        duration: Ticks(24),
        frames: Every(3),
        keys: {
            "body": [(t: 0, rot: -15, dy: -8), (t: 6, rot: -13, dy: -10), (t: 12, rot: -15, dy: -8), (t: 18, rot: -13, dy: -10), (t: 24, rot: -15, dy: -8)],
            "head": [(t: 0, rot: 3), (t: 12, rot: -3), (t: 24, rot: 3)],
            "leg_front": [(t: 0, rot: 22), (t: 12, rot: -21), (t: 24, rot: 22)],
            "leg_back": [(t: 0, rot: -21), (t: 12, rot: 22), (t: 24, rot: -21)],
            "arm_front": [(t: 0, rot: -22), (t: 12, rot: 21), (t: 24, rot: -22)],
            "arm_back": [(t: 0, rot: 21), (t: 12, rot: -22), (t: 24, rot: 21)],
        },
    ),
    // sprint 16：hp ≤ 50% 后（Sprint 触发）前倾 30°、嘴张开（5.4）
    (
        name: "sprint",
        looping: true,
        duration: Ticks(16),
        frames: Every(2),
        keys: {
            "body": [(t: 0, rot: -30, dy: -4), (t: 4, rot: -28, dy: -7), (t: 8, rot: -30, dy: -4), (t: 12, rot: -28, dy: -7), (t: 16, rot: -30, dy: -4)],
            "head": [(t: 0, rot: 3), (t: 8, rot: -3), (t: 16, rot: 3)],
            "leg_front": [(t: 0, rot: 28), (t: 8, rot: -27), (t: 16, rot: 28)],
            "leg_back": [(t: 0, rot: -27), (t: 8, rot: 28), (t: 16, rot: -27)],
            "arm_front": [(t: 0, rot: -26), (t: 8, rot: 25), (t: 16, rot: -26)],
            "arm_back": [(t: 0, rot: 25), (t: 8, rot: -26), (t: 16, rot: 25)],
            "speedlines": [(t: 0, dx: 4), (t: 8, dx: -2), (t: 16, dx: 4)],
        },
        swaps: {
            "mouth": [(0, "open")],
        },
    ),
    (
        name: "eat",
        looping: true,
        duration: Rule("enemies.sprinter_husk.bite_interval_ticks"),
        frames: List([10, 10, 10, 10, 10, 10]),
        events: [(50, "eat_hit")],
        keys: {
            "body": [(t: 0, rot: -8, dy: -6), (t: 30, rot: -10, dy: -6), (t: 40, rot: -16, dy: -6, dx: -2), (t: 50, rot: -20, dy: -6, dx: -3)],
            "head": [(t: 0, rot: 4), (t: 20, rot: 8), (t: 30), (t: 40, rot: -6), (t: 50, rot: -14)],
            "arm_front": [(t: 0, rot: 24), (t: 30, rot: 22), (t: 50, rot: 18)],
            "arm_back": [(t: 0, rot: 4), (t: 40, rot: -2), (t: 50, rot: -6)],
            "leg_front": [(t: 0, rot: 6)],
            "leg_back": [(t: 0, rot: -6)],
        },
        swaps: {
            "mouth": [(0, "base"), (50, "chomp")],
            "crumbs": [(50, "base")],
            "speedlines": [(0, "hidden")],
        },
    ),
])
