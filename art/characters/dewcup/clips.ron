// 露杯片段（ART-SPEC 3.1 / 4.2）。
Clips([
    // rest：完整默认位姿（审核表与卡牌头像用）
    (name: "rest", looping: false, duration: Ticks(60), frames: Every(60)),
    // idle 120：轻微摇摆；露珠在 produce 层
    (
        name: "idle",
        looping: true,
        duration: Ticks(120),
        frames: Every(15),
        keys: {
            "cup": [(t: 0, rot: -1.2), (t: 60, rot: 1.2), (t: 120, rot: -1.2)],
            "stem": [(t: 0, rot: -0.6), (t: 60, rot: 0.6), (t: 120, rot: -0.6)],
        },
        swaps: { "drop": [(0, "hidden")], "halo": [(0, "hidden")] },
    ),
    // produce：时长 = Producer.interval_ticks，相位由生产计时器驱动；pop 在 0（露水生成的 tick，ADR-014 第 5 条同理）。
    // 露珠直径随进度 12 → 28 px 并越来越亮，末 60 tick 光晕脉冲；pop 后打个哈欠。只画露珠层（ADR-016 第 2 节）
    (
        name: "produce",
        looping: true,
        duration: Rule("defenders.dewcup.producer.interval_ticks"),
        frames: List([40, 80, 120, 120, 120, 120, 120, 120, 120, 120, 120, 120, 60, 20, 20, 20]),
        events: [(0, "pop")],
        keys: {
            "drop": [(t: 0, sx: 0.55, sy: 0.55, ease: Linear), (t: 1380, sx: 1.27, sy: 1.27)],
            "halo": [(t: 0, sx: 0.45, sy: 0.45, ease: Linear), (t: 1380, sx: 1.1, sy: 1.1, ease: Linear), (t: 1400, sx: 1.3, sy: 1.3, ease: Linear), (t: 1420, sx: 1.12, sy: 1.12)],
        },
        swaps: {
            "shadow": [(0, "hidden")], "stem": [(0, "hidden")], "cup": [(0, "hidden")],
            "eyes": [(0, "hidden")], "mouth": [(0, "hidden")], "blush": [(0, "hidden")],
            "yawn": [(0, "base"), (40, "hidden")],
        },
    ),
])
