    "defender.pebble_pod.name": "石籽荚",
    "defender.pebble_pod.desc": "朝前方发射石籽。",
    "defender.dewcup.name": "露杯",
    "defender.dewcup.desc": "定期凝聚露水。",
    "defender.barkwall.name": "树皮墙",
    "defender.barkwall.desc": "厚实的树皮，挡住枯壳怪。",
    "defender.frostpod.name": "霜籽荚",
    "defender.frostpod.desc": "霜籽让枯壳怪减速。",
    "defender.twinpod.name": "双籽荚",
    "defender.twinpod.desc": "一次发射两枚石籽。",
    "defender.thornmat.name": "荆棘垫",
    "defender.thornmat.desc": "伤害走过它的枯壳怪，不会被啃。",
    "defender.tuberblast.name": "块茎雷",
    "defender.tuberblast.desc": "埋下后需要时间武装，触发时炸毁一格内的敌人。",
    "defender.emberbulb.name": "炽球",
    "defender.emberbulb.desc": "片刻后爆开，波及周围 3×3 格。",
    "defender.gourdshell.name": "葫芦壳",
    "defender.gourdshell.desc": "套在植物外面，替它承受伤害。",
    "defender.snapmaw.name": "咬夹草",
    "defender.snapmaw.desc": "一口吞下近处的枯壳怪，之后要咀嚼很久。",
    "defender.gustbloom.name": "风铃花",
    "defender.gustbloom.desc": "掀起一阵风，把整条车道的敌人吹回去。",
    "defender.sunlantern.name": "日灯笼",
    "defender.sunlantern.desc": "持续产露，每第四次额外多产一些。",
    "enemy.husk.name": "枯壳怪",
    "enemy.husk.desc": "普通的枯壳怪。",
    "enemy.twig_husk.name": "枝冠枯壳",
    "enemy.twig_husk.desc": "头顶枝冠，能多挨几下。",
    "enemy.clay_husk.name": "陶盔枯壳",
    "enemy.clay_husk.desc": "陶盔十分结实。",
    "enemy.sprinter_husk.name": "疾行枯壳",
    "enemy.sprinter_husk.desc": "受伤后跑得更快。",
    "enemy.vault_husk.name": "跳栏枯壳",
    "enemy.vault_husk.desc": "会跃过遇到的第一株植物。",
    "enemy.shield_husk.name": "门板枯壳",
    "enemy.shield_husk.desc": "门板挡住正面飞来的弹丸。",
    "enemy.carrier_husk.name": "背篓枯壳",
    "enemy.carrier_husk.desc": "倒下时背篓里会钻出小芽怪。",
    "enemy.drum_husk.name": "鼓腹枯壳",
    "enemy.drum_husk.desc": "又重又硬：吞不下，也吹不远。",
    "enemy.sproutling.name": "小芽怪",
    "enemy.sproutling.desc": "又小又快。",
}
