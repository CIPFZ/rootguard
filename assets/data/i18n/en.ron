    "defender.frostpod.desc": "Frost pebbles slow husks down.",
    "defender.twinpod.name": "Twinpod",
    "defender.twinpod.desc": "Fires two pebbles at a time.",
    "defender.thornmat.name": "Thornmat",
    "defender.thornmat.desc": "Hurts husks that walk over it and cannot be eaten.",
    "defender.tuberblast.name": "Tuberblast",
    "defender.tuberblast.desc": "Arms after a while, then blasts husks on its tile.",
    "defender.emberbulb.name": "Emberbulb",
    "defender.emberbulb.desc": "Bursts shortly after planting, hitting a 3×3 area.",
    "defender.gourdshell.name": "Gourdshell",
    "defender.gourdshell.desc": "Wraps a plant and takes damage for it.",
    "defender.snapmaw.name": "Snapmaw",
    "defender.snapmaw.desc": "Swallows a nearby husk whole, then chews for a long time.",
    "defender.gustbloom.name": "Gustbloom",
    "defender.gustbloom.desc": "Blows every husk in its lane back.",
    "defender.sunlantern.name": "Sunlantern",
    "defender.sunlantern.desc": "Produces dew, with a bonus every fourth time.",
    "enemy.husk.name": "Husk",
    "enemy.husk.desc": "An ordinary husk.",
    "enemy.twig_husk.name": "Twig Husk",
    "enemy.twig_husk.desc": "Its twig crown absorbs a few hits.",
    "enemy.clay_husk.name": "Clay Husk",
    "enemy.clay_husk.desc": "Its clay helm is tough.",
    "enemy.sprinter_husk.name": "Sprinter Husk",
    "enemy.sprinter_husk.desc": "Runs faster once hurt.",
    "enemy.vault_husk.name": "Vault Husk",
    "enemy.vault_husk.desc": "Leaps over the first plant it meets.",
    "enemy.shield_husk.name": "Shield Husk",
    "enemy.shield_husk.desc": "Its door blocks pebbles from the front.",
    "enemy.carrier_husk.name": "Carrier Husk",
    "enemy.carrier_husk.desc": "A sproutling climbs out of its basket when it falls.",
    "enemy.drum_husk.name": "Drum Husk",
    "enemy.drum_husk.desc": "Heavy and tough: cannot be swallowed and barely pushed.",
    "enemy.sproutling.name": "Sproutling",
    "enemy.sproutling.desc": "Small and quick.",
